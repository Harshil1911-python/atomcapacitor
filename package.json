    "@capacitor/share": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@capawesome/capacitor-android-edge-to-edge-support": "^6.0.0",
    "@capawesome/capacitor-navigation-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
